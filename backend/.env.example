# ─────────────────────────────────────────────
# Server
# ─────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─────────────────────────────────────────────
# External APIs
# ─────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model to use for AI analysis (default used in code: gemini-2.0-flash)
# GEMINI_MODEL=gemini-2.0-flash

# ─────────────────────────────────────────────
# CORS (comma-separated origins)
# ─────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ─────────────────────────────────────────────
# Monitoring (competitor tracking)
# ─────────────────────────────────────────────
# Cron expression for the monitoring job (default: every 6 hours)
MONITOR_CRON=0 */6 * * *
# Set to "true" to also run one cycle immediately when the server starts
MONITOR_RUN_ON_START=false
